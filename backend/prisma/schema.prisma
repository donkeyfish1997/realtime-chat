// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]

}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String   @unique // 用於 Email/密碼登入
  emailVerified DateTime? // 用於驗證電子郵件
  image         String?   // 頭像 URL
  
  accounts      Account[] // 關聯：一個 User 可以有多個 Account (多個登入方式)

  credential    Credential? 
  
  senderUser    Message[]   
  


  @@map("users") // 習慣將表名設定為複數
}

// =======================================================
// 2. Account 模型：代表一個登入憑證或連線，用於身份驗證
// =======================================================
model Account {
  id                String  @id @default(cuid())
  userId            String  // 外鍵：指向所屬的 User
  type              String  // 登入類型: "oauth" (第三方) 或 "credentials" (Email/密碼)
  provider          String  // 服務提供者 (如 "google", "github", "email")
  providerAccountId String  // 服務提供者的使用者 ID
  
  // OAuth 相關的 Token
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  // 關聯：多對一關係
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 確保 provider 和 providerAccountId 的組合是唯一的
  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Credential {
  id             String @id @default(cuid())
  email          String @unique
  passwordHash   String
  userId         String @unique

  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}




enum MessageStatus {
  SENT       // 訊息已從發送者發出
  DELIVERED  // 訊息已送達接收者的設備
  READ       // 訊息已被接收者閱讀
}
model Message {
  id                String    @id @default(cuid())
  sender_id         String
  content           String
  created_at        DateTime
  status            MessageStatus
  conversation_id   String

  senderUser        User  @relation( fields: [sender_id], references: [id], onDelete: Cascade)
  
  @@map("messages")
}
// content	TEXT	訊息的實際內容。	無

// status	ENUM/SMALLINT	訊息的狀態（例如：SENT, DELIVERED, READ）。	Index (用於未讀計數)
// conversation_id	UUID	簡化查詢用的對話 ID (見下方說明)。	Cluster/Composite Index